[
  {
    "name": "theme_info",
    "theme_name": "Dr Collagen",
    "theme_version": "1.0.0",
    "theme_author": "Dr Collagen",
    "theme_documentation_url": "https://drcollagen.in",
    "theme_support_url": "https://drcollagen.in/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "header",
        "content": "Brand identity"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Brand logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32 px .png recommended"
      },
      {
        "type": "text",
        "id": "tagline",
        "label": "Tagline",
        "default": "Japanese marine collagen, dosed and tested like a medicine."
      },
      {
        "type": "image_picker",
        "id": "og_image",
        "label": "Social share image (Open Graph)",
        "info": "1200 x 630 px .png/.jpg recommended. Used when a page is shared on WhatsApp, Instagram, Facebook, X, etc."
      },
      {
        "type": "email",
        "id": "support_email",
        "label": "Customer support email",
        "default": "support@drcollagen.in",
        "info": "Used in FAQ answers and the footer. Update if your support inbox changes."
      },
      {
        "type": "checkbox",
        "id": "show_testimonials",
        "label": "Show homepage testimonials section",
        "default": false,
        "info": "Disabled by default. Only enable once you have real, permissioned customer reviews \u2014 fabricated reviews violate consumer protection rules."
      },
      {
        "type": "header",
        "content": "Founders"
      },
      {
        "type": "paragraph",
        "content": "Upload founder portraits used on the homepage Founders section and the Our Story page. 800 x 1000 px portrait, .jpg/.png recommended. Until images are uploaded, initials are shown."
      },
      {
        "type": "image_picker",
        "id": "founder_1_image",
        "label": "Founder 1 portrait \u2014 Dr Nachiket Pansey"
      },
      {
        "type": "image_picker",
        "id": "founder_2_image",
        "label": "Founder 2 portrait \u2014 Dr Raashi Mehta"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Core palette"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Primary accent (gold)",
        "default": "#e8b72e"
      },
      {
        "type": "color",
        "id": "color_accent_deep",
        "label": "Deep accent",
        "default": "#b8903a"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Primary text",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_footer_bg",
        "label": "Footer background",
        "default": "#1a1225"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "paragraph",
        "content": "This theme uses Playfair Display (headings) and DM Sans (body) loaded from Google Fonts."
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_twitter",
        "label": "Twitter/X URL"
      }
    ]
  },
  {
    "name": "Gokwik",
    "settings": [
      {
        "type": "text",
        "id": "mid",
        "label": "Merchant Id"
      },
      {
        "type": "header",
        "content": "Select environment"
      },
      {
        "type": "select",
        "id": "envType",
        "options": [
          {
            "value": "qa",
            "label": "QA"
          },
          {
            "value": "sandbox",
            "label": "Sandbox"
          },
          {
            "value": "production",
            "label": "Production"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "hideFlow",
        "label": "Button hide without disable",
        "info": "To hide only button without disable Gokwik flow",
        "default": false
      },
      {
        "type": "header",
        "content": "Data Tracking"
      },
      {
        "type": "text",
        "id": "ga4Gokwik",
        "label": "Enter Google Analytics ID (GA4)",
        "placeholder": "Starts with GA- ...."
      },
      {
        "type": "text",
        "id": "fbpixel",
        "label": "FB Pixel"
      },
      {
        "type": "text",
        "id": "snapPixel",
        "label": "Snapchat Pixel"
      },
      {
        "type": "header",
        "content": "Checkout Button"
      },
      {
        "type": "checkbox",
        "id": "goEnable",
        "label": "Enable Checkout Interception",
        "info": "GoKwik will intercept native checkout buttons automatically",
        "default": true
      },
      {
        "type": "text",
        "id": "checkoutSubText",
        "label": "Checkout Button Sub Text",
        "placeholder": "e.g. \u20b9100 Off on prepaid orders",
        "info": "Leave blank to hide sub text on checkout button"
      },
      {
        "type": "checkbox",
        "id": "checkoutEnableLogo",
        "label": "Show Payment Icons on Checkout Button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "checkoutEnableBanner",
        "label": "Show Checkout Sub Text as Banner (above button)",
        "default": false
      },
      {
        "type": "header",
        "content": "Buy Now Button"
      },
      {
        "type": "checkbox",
        "id": "goBuynowEnable",
        "label": "Enable Buy Now Interception",
        "info": "GoKwik will intercept native buy now buttons automatically",
        "default": true
      },
      {
        "type": "text",
        "id": "buyNowText",
        "label": "Buy Now Button Text",
        "default": "Buy It Now"
      },
      {
        "type": "text",
        "id": "buyNowSubText",
        "label": "Buy Now Button Sub Text",
        "placeholder": "e.g. \u20b9100 Off on prepaid orders",
        "info": "Leave blank to hide sub text on buy now button"
      },
      {
        "type": "checkbox",
        "id": "buyNowEnableLogo",
        "label": "Show Payment Icons on Buy Now Button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "buyNowEnableBanner",
        "label": "Show Buy Now Sub Text as Banner (above button)",
        "default": false
      },
      {
        "type": "header",
        "content": "Other Settings"
      },
      {
        "type": "checkbox",
        "id": "enableIntlFlow",
        "label": "Enable International Flow"
      }
    ]
  }
]