{%- comment -%}
  dc-ugc-videos: real creator videos (barter batch, Oct 2026) in place of the
  old placeholder review marquee. Posters come from YouTube (no bytes until a
  card is tapped); the video itself loads in a modal via youtube-nocookie.
  Usage: {% render 'dc-ugc-videos', key: 'collabloom' %}  or  key: 'skelecoll'
{%- endcomment -%}
{%- if key == 'skelecoll' -%}
  {%- assign ugc_heading = 'Knees, backs and mornings, <em>in their words</em>.' -%}
  {%- assign ugc_ids    = 'bDtJ1f24qZY|CysUcp_wVVQ|8-x0zPXsNUs' | split: '|' -%}
  {%- assign ugc_names  = 'Anand|Shwet|Varun' | split: '|' -%}
  {%- assign ugc_labels = 'Day 30 on Skelecoll|Day 30 on Skelecoll|Skelecoll, in Hindi' | split: '|' -%}
  {%- assign ugc_layout = 'grid' -%}
{%- else -%}
  {%- assign ugc_heading = 'What three weeks of Collabloom looks like, <em>in their words</em>.' -%}
  {%- assign ugc_ids    = 'x-OGIxzV7Co|FgAkD9ytaOg|WXK4yZcuKFc|I36aKybXgAs|VRvGE_6jw9k|58NW066fSRE|e2IEFBIeM9g' | split: '|' -%}
  {%- assign ugc_names  = 'Ankita|Roshni|Rashmi|Astha|Anshu|Aarushree|Geet' | split: '|' -%}
  {%- assign ugc_labels = 'Day 21 on Collabloom|Her daily shot|Collabloom yogurt bowl|Her routine|Her routine|Her routine|Unboxing Collabloom' | split: '|' -%}
  {%- assign ugc_layout = 'marquee' -%}
{%- endif -%}
<style>
  #reviews { overflow: hidden; }
  .ugc-track {
    display: flex; gap: 20px; width: max-content; padding: 8px 0;
    animation: ugc-scroll 70s linear infinite; will-change: transform;
  }
  .ugc-marquee {
    position: relative; left: 50%; right: 50%; width: 100vw; max-width: 100vw;
    margin-left: -50vw; margin-right: -50vw; overflow: hidden;
  }
  .ugc-marquee:hover .ugc-track, .ugc-marquee:focus-within .ugc-track { animation-play-state: paused; }
  @keyframes ugc-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ugc-track { animation: none; } }
  .ugc-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; }
  .ugc-card {
    flex: 0 0 auto; width: 232px; border: 0; padding: 0; background: none;
    text-align: left; cursor: pointer; font: inherit; color: inherit;
  }
  .ugc-poster {
    position: relative; width: 100%; aspect-ratio: 9 / 16; border-radius: 20px; overflow: hidden;
    background: #111; box-shadow: 0 10px 30px rgba(0,0,0,.10);
    transition: transform .3s, box-shadow .3s;
  }
  .ugc-card:hover .ugc-poster, .ugc-card:focus-visible .ugc-poster { transform: translateY(-4px); box-shadow: 0 18px 44px rgba(0,0,0,.16); }
  .ugc-poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ugc-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,.45) 100%);
  }
  .ugc-play span {
    width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,.92);
    display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(0,0,0,.25);
  }
  .ugc-play svg { width: 22px; height: 22px; margin-left: 3px; fill: #111; }
  .ugc-meta { padding: 12px 4px 0; }
  .ugc-name { font-size: 14px; font-weight: 500; color: var(--ink, #222); }
  .ugc-label { font-size: 12px; font-weight: 300; color: var(--muted, #777); }
  .ugc-note { text-align: center; font-size: 12px; font-weight: 300; color: var(--muted, #777); margin-top: 28px; padding: 0 20px; }
  @media (max-width: 720px) { .ugc-card { width: 180px; } .ugc-track { gap: 14px; } .ugc-grid { gap: 14px; } }
  .ugc-modal { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,.88); display: flex; align-items: center; justify-content: center; padding: 16px; }
  .ugc-modal[hidden] { display: none; }
  .ugc-modal__frame { position: relative; height: min(88vh, 860px); aspect-ratio: 9 / 16; max-width: 96vw; background: #000; border-radius: 18px; overflow: hidden; }
  .ugc-modal__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ugc-modal__close {
    position: absolute; top: 14px; right: 14px; width: 44px; height: 44px; border-radius: 50%; border: 0;
    background: rgba(255,255,255,.92); color: #111; font-size: 26px; line-height: 44px; cursor: pointer; z-index: 2;
  }
</style>
<section id="reviews">
  <div class="inner">
    <div class="rev-head reveal">
      <p class="overline">Real Results</p>
      <h2 class="heading">{{ ugc_heading }}</h2>
    </div>
  </div>
  {%- if ugc_layout == 'marquee' -%}
  <div class="ugc-marquee" role="region" aria-label="Customer video reviews" tabindex="0">
    <div class="ugc-track">
      {%- for n in (1..2) -%}
        {%- for id in ugc_ids -%}
          {%- assign i = forloop.index0 -%}
          <button type="button" class="ugc-card" data-ugc-id="{{ id }}" aria-label="Play {{ ugc_names[i] }}'s video">
            <div class="ugc-poster">
              <img src="https://i.ytimg.com/vi/{{ id }}/oardefault.jpg" alt="" width="608" height="1080" loading="lazy" decoding="async" />
              <div class="ugc-play"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span></div>
            </div>
            <div class="ugc-meta"><div class="ugc-name">{{ ugc_names[i] }}</div><div class="ugc-label">{{ ugc_labels[i] }}</div></div>
          </button>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  {%- else -%}
  <div class="inner">
    <div class="ugc-grid" role="region" aria-label="Customer video reviews">
      {%- for id in ugc_ids -%}
        {%- assign i = forloop.index0 -%}
        <button type="button" class="ugc-card" data-ugc-id="{{ id }}" aria-label="Play {{ ugc_names[i] }}'s video">
          <div class="ugc-poster">
            <img src="https://i.ytimg.com/vi/{{ id }}/oardefault.jpg" alt="" width="608" height="1080" loading="lazy" decoding="async" />
            <div class="ugc-play"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span></div>
          </div>
          <div class="ugc-meta"><div class="ugc-name">{{ ugc_names[i] }}</div><div class="ugc-label">{{ ugc_labels[i] }}</div></div>
        </button>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
  <p class="ugc-note">These creators received the product from Dr Collagen. Individual results vary. A food supplement, not a medicine.</p>
</section>
<div class="ugc-modal" data-ugc-modal role="dialog" aria-modal="true" aria-label="Video review" hidden>
  <div class="ugc-modal__frame">
    <button type="button" class="ugc-modal__close" data-ugc-close aria-label="Close video">&times;</button>
  </div>
</div>
<script>
(function () {
  var modal = document.querySelector('[data-ugc-modal]');
  if (!modal) return;
  var frame = modal.querySelector('.ugc-modal__frame');
  function close() {
    var f = frame.querySelector('iframe'); if (f) f.remove();
    modal.hidden = true; document.body.style.overflow = '';
  }
  document.querySelectorAll('[data-ugc-id]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-ugc-id');
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&playsinline=1&rel=0&modestbranding=1';
      f.allow = 'autoplay; encrypted-media; picture-in-picture'; f.setAttribute('allowfullscreen', '');
      f.title = btn.getAttribute('aria-label') || 'Video review';
      frame.appendChild(f); modal.hidden = false; document.body.style.overflow = 'hidden';
    });
  });
  modal.querySelector('[data-ugc-close]').addEventListener('click', close);
  modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
})();
</script>
