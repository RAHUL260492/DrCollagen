{% comment %}
  JOURNAL INDEX — /pages/blog

  ┌──────────────────────────────────────────────────────────────────────┐
  │  TO PUBLISH A NEW ARTICLE, ADD ONE LINE TO jr_data BELOW.            │
  │  Newest first — the top line renders as the large featured card.     │
  │                                                                      │
  │  Fields, separated by ~~ :                                           │
  │    1 handle       page handle, e.g. collagen-for-skin                │
  │    2 title        headline shown on the card                         │
  │    3 dek          one-sentence summary                               │
  │    4 category     Skin Science | Joint Health                        │
  │    5 date_iso     2026-07-26   (machine-readable)                    │
  │    6 date_label   26 July 2026 (human-readable)                      │
  │    7 read_time    e.g. 9 min read                                    │
  │    8 image        asset filename                                     │
  │    9 plate        skin | joint  (background tint)                    │
  │                                                                      │
  │  Then add a {% when %} case in templates/page.liquid and a title +   │
  │  meta description in layout/theme.liquid. See JOURNAL-HOWTO.md.      │
  └──────────────────────────────────────────────────────────────────────┘
{% endcomment %}

{% render 'journal-styles' %}

